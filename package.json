{
  "name": "remotion-2d-rig-toolkit",
  "version": "0.2.0",
  "description": "Deterministic 2D arm IK, jointed cartoon hands and prop pickup/release helpers with continuity checks, for Remotion and other frame-based renderers.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "remotion",
    "animation",
    "2d",
    "inverse-kinematics",
    "ik",
    "character-rig",
    "rigging",
    "hand-pose",
    "svg",
    "typescript",
    "motion-graphics"
  ],
  "homepage": "https://github.com/Trendtee/remotion-2d-rig-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trendtee/remotion-2d-rig-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/Trendtee/remotion-2d-rig-toolkit/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
