{
  "name": "remotion-2d-rig-toolkit",
  "version": "0.1.0",
  "description": "Framework-agnostic 2D arm IK and anchored prop interaction helpers for Remotion projects.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "keywords": [
    "remotion",
    "animation",
    "2d",
    "inverse-kinematics",
    "svg",
    "rigging",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
